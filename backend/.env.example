# Environment variables for backend
# Copy this file to .env and update values

DATABASE_URL=postgresql://rag_user:rag_password@postgres:5432/rag_db
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
SECRET_KEY=your-secret-key-change-in-production-please-use-strong-random-string
MODEL_NAME=openai-community/gpt2
EMBEDDING_MODEL=intfloat/multilingual-e5-large
XML_CATALOG_URL=https://av.my-step.eu/avaliable_products.xml
UPLOAD_DIR=/app/uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=50
